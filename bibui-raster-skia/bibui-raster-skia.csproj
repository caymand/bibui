<Project Sdk="Microsoft.NET.Sdk">
  <!-- nuget.org metadata of a public package: URLs, icon, README, base tags. -->
  <Import Project="../packaging/PublicPackage.props" />

  <!-- SkiaGlRenderer and SkiaCpuRenderer: draw bibui's DrawList with SkiaSharp,
       on a window's GL context or into memory. Out of the core library, so an
       app that draws with the managed rasterizer ships no libSkiaSharp. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Bibui.Raster.Skia</AssemblyName>
    <RootNamespace>Bibui.Raster.Skia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Pins caller spans (pixels in, pixels out) with `fixed`. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
    <PackageId>Bibui.Raster.Skia</PackageId>
    <Description>Draws Bibui's DrawList with SkiaSharp: SkiaGlRenderer on a window's GL context (GPU), SkiaMetalRenderer on a macOS window's Metal layer (GPU), SkiaCpuRenderer into memory (CPU). The app constructs the one it wants, bound to the window's target.</Description>
    <PackageTags>$(PackageTags);skia;skiasharp;rendering</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../bibui-core/bibui-core.csproj" />
    <!-- GlTarget and the GL texture calls SkiaGlRenderer makes its textures with. -->
    <ProjectReference Include="../bibui-gl/bibui-gl.csproj" />
    <!-- MetalLayer and the Metal texture calls SkiaMetalRenderer makes its textures with. -->
    <ProjectReference Include="../bibui-metal/bibui-metal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The licence and the third-party notices travel with the package. -->
    <None Include="../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../NOTICE" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
